REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_GOOGLE_DRIVE_API_KEY=
REACT_APP_GOOGLE_DRIVE_UPLOAD_ENDPOINT=
REACT_APP_SENTRY_DSN=
REACT_APP_PUBLIC_APP_URL=

# Push notifications (Web Push VAPID)
# Generate keys: node scripts/generate-vapid-keys.js
# Private key lives in Supabase project secrets. Never expose it client-side.
# Public key is safe for the browser.
REACT_APP_VAPID_PUBLIC_KEY=

# ─── Edge Function secrets (Supabase project secrets — NEVER REACT_APP_*, NEVER committed) ──────
# Set with:  supabase secrets set NAME=value   (or Dashboard → Edge Functions → Secrets)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
#
# Email provider (one of):
#   RESEND_API_KEY=
#   SENDGRID_API_KEY=
#   EMAIL_FROM="BLW York Hub <no-reply@your-domain.com>"
#
# Signs unsubscribe links (HMAC-SHA256). REQUIRED for send-email + unsubscribe. >= 32 random bytes:
#   openssl rand -base64 48
#   UNSUBSCRIBE_SECRET=
#
# Shared secret the scheduler must send as the `x-cron-secret` header to process-scheduled-emails.
# REQUIRED (the function refuses to run without it). >= 32 random bytes:
#   CRON_SECRET=
#
# Public app origin (unsubscribe redirect + "manage preferences" links), e.g. https://blw-york.vercel.app
#   PUBLIC_APP_URL=
#
# Comma-separated browser origins allowed to call send-email (CORS). Unset => "*" (bearer-token auth only).
#   ALLOWED_ORIGINS=https://blw-york.vercel.app

# Zoom
# Zoom credentials live in Supabase project secrets:
# ZOOM_ACCOUNT_ID, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET
